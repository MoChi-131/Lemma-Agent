# Lark application credentials
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# Wiki resolution/children, Base records, document text and blocks use official Lark MCP
# over private stdio, with these same credentials. No extra port or OAuth login.

# HTTP MCP port. Health: /health; ChatGPT or Tunnel endpoint: /mcp.
PORT=6688

# Console colors: auto (terminal only), always (PM2/Docker), never. NO_COLOR disables colors.
LOG_COLOR=auto

# Operations: prune only files inside logs/ older than this many days. Run `npm.cmd run logs:prune` daily.
LOG_RETENTION_DAYS=14
# Optional HTTPS incident webhook. Alerts are redacted and deduplicated for 60 seconds.
# ERROR_WEBHOOK_URL=https://your-alert-endpoint.example/webhook

# Knowledge comes from the published mirror, not the colleagues' working Registry.
# LARK_VALIDATED_METADATA_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=VALIDATED_TABLE_ID
# LARK_VALIDATION_JOURNAL_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=JOURNAL_TABLE_ID
# Optional web-search whitelist override.
# LARK_WHITELIST_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=WHITELIST_TABLE_ID

# 文件儲存：設定可新增文件的 Wiki 範圍；同事批准後才寫入。
# LARK_DOCUMENT_WIKI_ROOT_URL=https://your-tenant.larksuite.com/wiki/ROOT_TOKEN
ENABLE_LARK_DOCUMENT_WRITES=false

# Local-only: use a previously completed official Lark OAuth login for one-user write testing.
# Never enable this on AWS; production needs per-user OAuth sessions.
LEMMA_LARK_USER_OAUTH=false
