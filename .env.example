# Lark application credentials
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# HTTP MCP port. Health: /health; ChatGPT or Tunnel endpoint: /mcp.
PORT=6688

# Knowledge comes from the published mirror, not the colleagues' working Registry.
# LARK_VALIDATED_METADATA_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=VALIDATED_TABLE_ID
# LARK_VALIDATION_JOURNAL_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=JOURNAL_TABLE_ID
# Optional web-search whitelist override.
# LARK_WHITELIST_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=WHITELIST_TABLE_ID

# 文件儲存：設定可新增文件的 Wiki 範圍；同事批准後才寫入。
# LARK_DOCUMENT_WIKI_ROOT_URL=https://your-tenant.larksuite.com/wiki/ROOT_TOKEN
ENABLE_LARK_DOCUMENT_WRITES=false

