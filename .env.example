# Lark application credentials
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# Optional table overrides. The code defaults to the project registry and whitelist.
# LARK_REGISTRY_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=TABLE_ID
# LARK_WHITELIST_URL=https://your-tenant.larksuite.com/base/BASE_TOKEN?table=WHITELIST_TABLE_ID

# Optional: expose full conflict tools for a dedicated Knowledge Base Management Agent.
ENABLE_CONFLICT_TOOLS=false
# Optional: expose detailed registry audits for the Knowledge Base Management Agent.
ENABLE_VALIDATION_TOOLS=false
